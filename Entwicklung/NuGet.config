<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Lokale NuGet-Konfiguration für die Solution.

    Beim Auftreten von:
       "Microsoft.NETCore.App.Runtime.win-x86 (= 9.0.X) kann für
        net9.0-windowsXXXXX nicht aufgelöst werden.
        PackageSourceMapping ist aktiviert. Die folgende(n) Quelle(n)
        wurde(n) nicht berücksichtigt: ..."
    blockiert das globale (z. B. firmeninterne) PackageSourceMapping die
    Microsoft.NETCore.App.Runtime.*-Pakete für nuget.org. Diese Datei
    setzt das Mapping projektlokal so, dass die Runtime-Pakete sicher
    von nuget.org bezogen werden dürfen.

    Falls eine eigene Feed-URL (z. B. ProGet, Azure Artifacts) erforderlich
    ist, dort eine zusätzliche <add key="..." value="..."/> ergänzen und
    das Mapping ggf. anpassen.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.*" />
      <package pattern="Microsoft.NETCore.App.Runtime.*" />
      <package pattern="Microsoft.WindowsAppSDK*" />
      <package pattern="Microsoft.Windows.SDK.*" />
      <package pattern="System.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
