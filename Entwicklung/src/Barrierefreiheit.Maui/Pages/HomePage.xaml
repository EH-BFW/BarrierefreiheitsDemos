<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Barrierefreiheit.Maui.Pages.HomePage"
             Title="Startseite">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Style="{StaticResource H1}" Text="Barrierefreiheit in .NET MAUI" />
            <Label Text="Diese MAUI-App zeigt typische digitale Barrieren auf Mobilgeräten und Desktop – und die jeweilige barrierefreie Lösung." />
            <Label Text="Wechseln Sie über das Menü zwischen Barrieren-Beispiel und Lösungs-Beispiel, um den Unterschied direkt mit TalkBack, VoiceOver oder Narrator zu erleben." />

            <Frame BorderColor="{StaticResource BfwGreyLight}" CornerRadius="4" Padding="14" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Style="{StaticResource H2}" Text="Hinweis" />
                    <Label Text="In .NET MAUI erfolgt die Anbindung an Screenreader plattformübergreifend über SemanticProperties (Description, Hint, HeadingLevel)." />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
