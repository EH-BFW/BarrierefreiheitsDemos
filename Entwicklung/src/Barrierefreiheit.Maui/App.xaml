<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Barrierefreiheit.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="BfwRed">#C8102E</Color>
            <Color x:Key="BfwRedDark">#9C0C24</Color>
            <Color x:Key="BfwAnthracite">#1F2A36</Color>
            <Color x:Key="BfwGrey">#5A6470</Color>
            <Color x:Key="BfwGreyLight">#E9ECEF</Color>

            <Style TargetType="Label" x:Key="H1">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BfwRed}" />
            </Style>
            <Style TargetType="Label" x:Key="H2">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource BfwAnthracite}" />
            </Style>
            <Style TargetType="Label" x:Key="Hint">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Italic" />
                <Setter Property="TextColor" Value="{StaticResource BfwGrey}" />
            </Style>
            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="BackgroundColor" Value="{StaticResource BfwRed}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BorderColor" Value="{StaticResource BfwRedDark}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinimumWidthRequest" Value="120" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
