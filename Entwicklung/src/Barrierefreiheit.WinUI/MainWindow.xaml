<Window
    x:Class="Barrierefreiheit.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Barrierefreiheit.WinUI"
    xmlns:pages="using:Barrierefreiheit.WinUI.Pages">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BfwAnthracite}" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Polygon Points="0,0 16,8 0,16" Fill="{StaticResource BfwRed}" VerticalAlignment="Center" />
                <TextBlock Text="BFW Würzburg · Barrierefreiheit (WinUI 3)"
                           Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged"
                        AutomationProperties.Name="Hauptnavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Startseite" Tag="home" Icon="Home" />
                <NavigationViewItem Content="Barrieren-Beispiel" Tag="barrieren">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Important" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Lösungs-Beispiel" Tag="loesungen">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Accept" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Über diese App" Tag="ueber">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" AutomationProperties.Name="Inhaltsbereich" />
        </NavigationView>
    </Grid>
</Window>
