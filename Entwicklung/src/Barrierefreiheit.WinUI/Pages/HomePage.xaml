<Page
    x:Class="Barrierefreiheit.WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="12">
            <TextBlock Text="Barrierefreiheit in WinUI 3 – Beispiel-App"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource BfwRed}" />
            <TextBlock TextWrapping="Wrap" FontSize="16">
                Diese WinUI-3-App zeigt typische digitale Barrieren in modernen Windows-Apps –
                und die jeweilige barrierefreie Lösung.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="14">
                Wechseln Sie über das Menü zwischen Barrieren-Beispiel und Lösungs-Beispiel,
                um den Unterschied direkt mit NVDA, JAWS oder Narrator zu erleben.
            </TextBlock>

            <Border BorderBrush="#E9ECEF" BorderThickness="1" Padding="16" CornerRadius="4" Margin="0,12,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="Hinweis zu UI-Automation" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock TextWrapping="Wrap">
                        In WinUI 3 erfolgt die Anbindung an Screenreader über AutomationProperties
                        (Name, HelpText, LabeledBy) – analog zu WPF, aber im neueren XAML-Dialekt.
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
