<Application x:Class="Barrierefreiheit.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- BFW-CD -->
            <Color x:Key="BfwRedColor">#C8102E</Color>
            <Color x:Key="BfwRedDarkColor">#9C0C24</Color>
            <Color x:Key="BfwAnthraciteColor">#1F2A36</Color>
            <Color x:Key="BfwGreyColor">#5A6470</Color>
            <Color x:Key="BfwGreyLightColor">#E9ECEF</Color>

            <SolidColorBrush x:Key="BfwRed" Color="{StaticResource BfwRedColor}" />
            <SolidColorBrush x:Key="BfwRedDark" Color="{StaticResource BfwRedDarkColor}" />
            <SolidColorBrush x:Key="BfwAnthracite" Color="{StaticResource BfwAnthraciteColor}" />
            <SolidColorBrush x:Key="BfwGrey" Color="{StaticResource BfwGreyColor}" />
            <SolidColorBrush x:Key="BfwGreyLight" Color="{StaticResource BfwGreyLightColor}" />

            <Style TargetType="TextBlock" x:Key="H1">
                <Setter Property="Foreground" Value="{StaticResource BfwRed}" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style TargetType="TextBlock" x:Key="H2">
                <Setter Property="Foreground" Value="{StaticResource BfwAnthracite}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,16,0,8" />
            </Style>

            <Style TargetType="Button" x:Key="PrimaryButton">
                <Setter Property="Background" Value="{StaticResource BfwRed}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource BfwRedDark}" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinWidth" Value="120" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
