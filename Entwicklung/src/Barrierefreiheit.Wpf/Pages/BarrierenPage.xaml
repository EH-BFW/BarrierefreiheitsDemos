<Page x:Class="Barrierefreiheit.Wpf.Pages.BarrierenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Barrieren-Beispiel"
      FontFamily="Segoe UI" FontSize="14">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Barrieren-Beispiel (WPF)" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                Achtung: Diese Seite ist <Run FontWeight="SemiBold">bewusst nicht barrierefrei</Run>.
                Sie demonstriert typische Hürden für Screenreader-Nutzende.
            </TextBlock>

            <!-- 1: Unbeschriftetes Eingabefeld -->
            <Border BorderBrush="{StaticResource BfwGreyLight}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="1. Unbeschriftetes Eingabefeld" />
                    <!-- BARRIERE: kein AutomationProperties.Name, kein verknüpftes Label -->
                    <TextBox Width="280" HorizontalAlignment="Left" Padding="6" />
                </StackPanel>
            </Border>

            <!-- 2: IsEnabled=False statt IsReadOnly=True -->
            <Border BorderBrush="{StaticResource BfwGreyLight}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="2. Per Tastatur nicht erreichbares Feld (IsEnabled=False)" />
                    <TextBlock Text="Kundennummer" />
                    <!-- BARRIERE: IsEnabled=False -> kein Fokus, schlecht erfassbar -->
                    <TextBox Width="280" HorizontalAlignment="Left" Padding="6"
                             Text="K-4711" IsEnabled="False" />
                </StackPanel>
            </Border>

            <!-- 3: Fokussierbares, unbeschriftetes Diagramm -->
            <Border BorderBrush="{StaticResource BfwGreyLight}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="3. Fokussierbares, aber unbeschriftetes Diagramm" />
                    <!-- BARRIERE: Focusable=True, aber kein Name/HelpText -->
                    <Border BorderBrush="{StaticResource BfwGrey}" BorderThickness="1" Padding="6"
                            Width="240" Height="100" HorizontalAlignment="Left"
                            Focusable="True">
                        <Canvas>
                            <Rectangle Canvas.Left="10"  Canvas.Top="50" Width="20" Height="30" Fill="#888"/>
                            <Rectangle Canvas.Left="40"  Canvas.Top="30" Width="20" Height="50" Fill="#888"/>
                            <Rectangle Canvas.Left="70"  Canvas.Top="20" Width="20" Height="60" Fill="#888"/>
                            <Rectangle Canvas.Left="100" Canvas.Top="40" Width="20" Height="40" Fill="#888"/>
                            <Rectangle Canvas.Left="130" Canvas.Top="35" Width="20" Height="45" Fill="#888"/>
                        </Canvas>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4: Schaltfläche mit zu schwachem Kontrast -->
            <Border BorderBrush="{StaticResource BfwGreyLight}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="4. Schaltfläche mit zu schwachem Kontrast" />
                    <Button Content="Speichern"
                            Foreground="#CCCCCC" Background="White"
                            BorderBrush="#EEEEEE" BorderThickness="1"
                            Padding="12,6" Width="120" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- 5: Icon-Schaltfläche ohne Beschriftung -->
            <Border BorderBrush="{StaticResource BfwGreyLight}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="5. Icon-Schaltfläche ohne Beschriftung" />
                    <!-- BARRIERE: nur ein Pfad-Icon, keine AutomationProperties.Name -->
                    <Button Width="40" Height="36" HorizontalAlignment="Left">
                        <Path Stroke="#333" StrokeThickness="2" Fill="Transparent"
                              Data="M3,6 L21,6 M8,6 L8,4 L16,4 L16,6 M6,6 L7,20 L17,20 L18,6" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
