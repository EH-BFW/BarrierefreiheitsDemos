<Page
    x:Class="Barrierefreiheit.Wpf.Pages.BarrierenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Barrieren-Beispiel"
    FontFamily="Segoe UI"
    FontSize="14">
    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Barrieren-Beispiel (WPF)" />
            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap">
                Achtung: Diese Seite ist<Run FontWeight="SemiBold">bewusst nicht barrierefrei</Run>
                .
                Sie demonstriert typische Hürden für Screenreader-Nutzende.</TextBlock>

            <!--  1: Unbeschriftetes Eingabefeld  -->
            <Border
                Padding="0,12"
                BorderBrush="{StaticResource BfwGreyLight}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  BARRIERE: kein AutomationProperties.Name, kein verknüpftes Label  -->
                    <TextBox
                        Grid.Row="1"
                        Width="280"
                        Padding="6"
                        HorizontalAlignment="Left" />
                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource H2}"
                        Text="1. Eingabefeld ohne Beschriftung/Label" />
                </Grid>
            </Border>

            <!--  2: IsEnabled=False statt IsReadOnly=True  -->
            <Border
                Padding="0,12"
                BorderBrush="{StaticResource BfwGreyLight}"
                BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="2. Per Tastatur nicht erreichbares Feld (IsEnabled=False)" />
                    <TextBlock Text="Kundennummer" />
                    <!--  BARRIERE: IsEnabled=False -> kein Fokus, schlecht erfassbar  -->
                    <TextBox
                        Width="280"
                        Padding="6"
                        HorizontalAlignment="Left"
                        IsEnabled="False"
                        Text="K-4711" />
                </StackPanel>
            </Border>

            <!--  3: Fokussierbares, unbeschriftetes Diagramm  -->
            <Border
                Padding="0,12"
                BorderBrush="{StaticResource BfwGreyLight}"
                BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="3. Fokussierbares, aber unbeschriftetes Diagramm" />
                    <!--  BARRIERE: Focusable=True, aber kein Name/HelpText  -->
                    <Border
                        Width="240"
                        Height="100"
                        Padding="6"
                        HorizontalAlignment="Left"
                        BorderBrush="{StaticResource BfwGrey}"
                        BorderThickness="1"
                        Focusable="True"
                        IsEnabled="True">
                        <Canvas>
                            <Rectangle
                                Canvas.Left="10"
                                Canvas.Top="50"
                                Width="20"
                                Height="30"
                                Fill="#888" />
                            <Rectangle
                                Canvas.Left="40"
                                Canvas.Top="30"
                                Width="20"
                                Height="50"
                                Fill="#888" />
                            <Rectangle
                                Canvas.Left="70"
                                Canvas.Top="20"
                                Width="20"
                                Height="60"
                                Fill="#888" />
                            <Rectangle
                                Canvas.Left="100"
                                Canvas.Top="40"
                                Width="20"
                                Height="40"
                                Fill="#888" />
                            <Rectangle
                                Canvas.Left="130"
                                Canvas.Top="35"
                                Width="20"
                                Height="45"
                                Fill="#888" />
                        </Canvas>
                    </Border>
                </StackPanel>
            </Border>

            <!--  4: Schaltfläche mit zu schwachem Kontrast  -->
            <Border
                Padding="0,12"
                BorderBrush="{StaticResource BfwGreyLight}"
                BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="4. Schaltfläche mit zu schwachem Kontrast" />
                    <Button
                        Width="120"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="#EEEEEE"
                        BorderThickness="1"
                        Content="Speichern"
                        Foreground="#CCCCCC" />
                </StackPanel>
            </Border>

            <!--  5: Icon-Schaltfläche ohne Beschriftung  -->
            <Border
                Padding="0,12"
                BorderBrush="{StaticResource BfwGreyLight}"
                BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="5. Icon-Schaltfläche ohne Beschriftung" />
                    <!--  BARRIERE: nur ein Pfad-Icon, keine AutomationProperties.Name  -->
                    <Button
                        Width="40"
                        Height="36"
                        HorizontalAlignment="Left">
                        <Path
                            Data="M3,6 L21,6 M8,6 L8,4 L16,4 L16,6 M6,6 L7,20 L17,20 L18,6"
                            Fill="Transparent"
                            Stroke="#333"
                            StrokeThickness="2" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
