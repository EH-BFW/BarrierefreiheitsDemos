<Page x:Class="Barrierefreiheit.Wpf.Pages.LoesungenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:Barrierefreiheit.Wpf.Controls"
      Title="Lösungs-Beispiel"
      FontFamily="Segoe UI" FontSize="14">

    <Page.Resources>
        <!--
            Fokus-Hervorhebung für die Lösungs-Seite: 3 Pixel rot.
            Wird als FocusVisualStyle auf Buttons und ChartControl
            angewendet. TextBox zeigt das FocusVisual von WPF nicht
            zuverlässig an, deshalb wird dort der Rand selbst über
            IsKeyboardFocusWithin auf rot/3 px gesetzt.
        -->
        <Style x:Key="BfwFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3"
                                   Stroke="{StaticResource BfwRed}"
                                   StrokeThickness="3"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implizit für alle Buttons ohne expliziten Style -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BfwFocusVisual}" />
        </Style>

        <!-- Implizit für das eigene ChartControl -->
        <Style TargetType="{x:Type controls:ChartControl}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BfwFocusVisual}" />
        </Style>

        <!-- TextBox: roten 3-px-Rahmen via IsKeyboardFocusWithin -->
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BfwFocusVisual}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BfwRed}" />
                    <Setter Property="BorderThickness" Value="3" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Lösungs-Beispiel (WPF)" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
                Identische Beispiele – diesmal <Run FontWeight="SemiBold">barrierefrei umgesetzt</Run>.
                Die jeweilige Lösung steht direkt unter dem Beispiel.
            </TextBlock>

            <!-- 1: Beschriftetes Eingabefeld -->
            <Border BorderBrush="{StaticResource BfwGreyLight}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="1. Beschriftetes Eingabefeld" />
                    <Label x:Name="LblName" Target="{Binding ElementName=TxtName}" Padding="0">
                        <AccessText Text="_Vor- und Nachname" />
                    </Label>
                    <TextBox x:Name="TxtName" Width="280" HorizontalAlignment="Left" Padding="6"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblName}" />
                    <TextBlock Foreground="{StaticResource BfwGrey}" FontStyle="Italic">
                        Lösung: Label mit Target + AccessKey + AutomationProperties.LabeledBy.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 2: IsReadOnly statt IsEnabled=False -->
            <Border BorderBrush="{StaticResource BfwGreyLight}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="2. Schreibgeschütztes, aber fokussierbares Feld" />
                    <Label x:Name="LblKdNr" Target="{Binding ElementName=TxtKdNr}" Padding="0">
                        <AccessText Text="_Kundennummer" />
                    </Label>
                    <TextBox x:Name="TxtKdNr" Width="280" HorizontalAlignment="Left" Padding="6"
                             Text="K-4711" IsReadOnly="True"
                             AutomationProperties.LabeledBy="{Binding ElementName=LblKdNr}" />
                    <TextBlock Foreground="{StaticResource BfwGrey}" FontStyle="Italic">
                        Lösung: IsReadOnly="True" – fokussierbar und vorlesbar.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 3: Beschriftetes Diagramm -->
            <Border BorderBrush="{StaticResource BfwGreyLight}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="3. Beschriftetes Diagramm" />
                    <!-- ChartControl exponiert das Diagramm als UIA-Image
                         mit eigener AutomationPeer-Klasse - JAWS/NVDA
                         lesen es als "Grafik". -->
                    <controls:ChartControl
                        Width="240" Height="100" HorizontalAlignment="Left"
                        BorderBrush="{StaticResource BfwGrey}" BorderThickness="1"
                        Padding="6"
                        AutomationProperties.Name="Umsätze Q1 bis Q5"
                        AutomationProperties.HelpText="Balkendiagramm: Q1 30, Q2 50, Q3 60, Q4 40, Q5 45 Tausend Euro.">
                        <controls:ChartControl.Template>
                            <ControlTemplate TargetType="ContentControl">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </controls:ChartControl.Template>
                        <Canvas>
                            <Rectangle Canvas.Left="10"  Canvas.Top="50" Width="20" Height="30" Fill="{StaticResource BfwRed}"/>
                            <Rectangle Canvas.Left="40"  Canvas.Top="30" Width="20" Height="50" Fill="{StaticResource BfwRed}"/>
                            <Rectangle Canvas.Left="70"  Canvas.Top="20" Width="20" Height="60" Fill="{StaticResource BfwRed}"/>
                            <Rectangle Canvas.Left="100" Canvas.Top="40" Width="20" Height="40" Fill="{StaticResource BfwRed}"/>
                            <Rectangle Canvas.Left="130" Canvas.Top="35" Width="20" Height="45" Fill="{StaticResource BfwRed}"/>
                        </Canvas>
                    </controls:ChartControl>
                    <TextBlock Foreground="{StaticResource BfwGrey}" FontStyle="Italic">
                        Lösung: eigene ChartControl-Klasse mit AutomationPeer → Rolle "Image" + Name + HelpText.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 4: Kontrast-konforme Schaltfläche -->
            <Border BorderBrush="{StaticResource BfwGreyLight}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="4. Schaltfläche mit ausreichendem Kontrast" />
                    <!-- expliziter Style überschreibt den impliziten Button-Style,
                         deshalb FocusVisualStyle hier zusätzlich direkt setzen -->
                    <Button Content="Speichern" Style="{StaticResource PrimaryButton}"
                            FocusVisualStyle="{StaticResource BfwFocusVisual}"
                            HorizontalAlignment="Left" />
                    <TextBlock Foreground="{StaticResource BfwGrey}" FontStyle="Italic">
                        Lösung: Weiß auf BFW-Rot – Kontrastverhältnis ≥ 4,5:1 (WCAG AA).
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 5: Icon-Schaltfläche mit Namen -->
            <Border BorderBrush="{StaticResource BfwGreyLight}" BorderThickness="0,0,0,1" Padding="0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="5. Icon-Schaltfläche mit Beschriftung" />
                    <Button Width="40" Height="36" HorizontalAlignment="Left"
                            AutomationProperties.Name="Eintrag löschen"
                            ToolTip="Eintrag löschen">
                        <Path Stroke="#333" StrokeThickness="2" Fill="Transparent"
                              Data="M3,6 L21,6 M8,6 L8,4 L16,4 L16,6 M6,6 L7,20 L17,20 L18,6" />
                    </Button>
                    <TextBlock Foreground="{StaticResource BfwGrey}" FontStyle="Italic">
                        Lösung: AutomationProperties.Name + ToolTip.
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
